# .env.example - contains no real credentials.
# Copy this file to .env and fill in your own values. .env is gitignored.

# Anthropic API key (https://console.anthropic.com). Leave blank to run without AI features.
# The agent always uses Claude Sonnet 5.5 (claude-sonnet-5-5).
ANTHROPIC_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Reasoning effort sent to the model: low | medium | high | xhigh | max
LLM_EFFORT=medium

# Maximum tool-calling steps the agent may take for one message.
AGENT_MAX_STEPS=8

# SQLite database file (created and seeded on first run).
DB_PATH=data/library.db

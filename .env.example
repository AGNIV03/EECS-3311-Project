# .env.example - contains no real credentials.
# Copy this file to .env and fill in your own values. .env is gitignored.

# Anthropic API key (https://console.anthropic.com). Leave blank to run without AI features.
# The agent always uses Claude Sonnet 5.5 (claude-sonnet-5-5).
ANTHROPIC_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Reasoning effort sent to the model: low | medium | high | xhigh | max
LLM_EFFORT=medium

# Maximum tool-calling steps the agent may take for one message.
AGENT_MAX_STEPS=8

# SQLite database file (created and seeded on first run).
DB_PATH=data/library.db

# ---- Web version only (gradlew runWeb, or docker compose) ---------------------------------

# Public domain name served by Caddy with automatic HTTPS (docker compose only).
DOMAIN=library.example.com

# Port the web server listens on.
WEB_PORT=8080

# Estimated AI spend allowed per day (USD). Chat is refused for the rest of the day once reached.
DAILY_BUDGET_USD=2.00

# Chat messages allowed per visitor (IP address).
CHAT_LIMIT_PER_MINUTE=6
CHAT_LIMIT_PER_HOUR=40

# Passcode required to sign in as a librarian on the website. Leave blank to disable librarian
# sign-in on the website entirely.
LIBRARIAN_PASSCODE=
